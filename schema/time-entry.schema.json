{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sanikolaev/github-time-tracker-extension/schema/time-entry.schema.json",
  "title": "GitHub Private Time Entry",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "user",
    "issue",
    "entryDate",
    "startedAt",
    "endedAt",
    "durationSeconds",
    "description",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "user": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
    },
    "issue": {
      "type": "object",
      "required": [
        "type",
        "owner",
        "repo",
        "number",
        "url"
      ],
      "properties": {
        "type": {
          "const": "issue"
        },
        "owner": {
          "type": "string"
        },
        "repo": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/"
        }
      },
      "additionalProperties": true
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "durationSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entryDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": true
}
