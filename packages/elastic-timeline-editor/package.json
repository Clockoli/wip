{
  "name": "elastic-timeline-editor",
  "version": "0.1.0",
  "description": "Framework-neutral elastic timeline editor for editable time intervals",
  "license": "MIT",
  "type": "module",
  "types": "./types/index.d.ts",
  "style": "./dist/elastic-timeline-editor.css",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/elastic-timeline-editor.js",
  "module": "./dist/elastic-timeline-editor.js",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/elastic-timeline-editor.js"
    },
    "./style.css": "./dist/elastic-timeline-editor.css"
  },
  "files": [
    "dist",
    "types",
    "docs/API.md",
    "elastic-timeline-ui-component-spec.ru.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "keywords": [
    "timeline",
    "time-tracking",
    "editor",
    "vanilla-javascript",
    "framework-neutral"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:content-script": "vite build --config vite.content-script.config.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:package": "npm run build && node scripts/package-smoke.mjs",
    "test:all": "npm test && npm run test:e2e && npm run test:package",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.3"
  }
}
