{
  "manifest_version": 3,
  "name": "Clockoli",
  "version": "0.1.30",
  "description": "Track time on any task URL and store records in a private GitHub repository.",
  "permissions": [
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/login/*",
    "https://api.frankfurter.dev/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clockoli",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/clockoli-16.png",
      "32": "src/assets/clockoli-32.png",
      "48": "src/assets/clockoli-48.png",
      "128": "src/assets/clockoli-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/domain/recovery-actions.js",
        "src/content/github.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": ["https://github.com/*"],
      "resources": [
        "src/assets/clockoli-16.png", "src/assets/clockoli-32.png",
        "src/assets/action-spin/clockoli-16-0.png", "src/assets/action-spin/clockoli-32-0.png",
        "src/assets/action-spin/clockoli-16-1.png", "src/assets/action-spin/clockoli-32-1.png",
        "src/assets/action-spin/clockoli-16-2.png", "src/assets/action-spin/clockoli-32-2.png",
        "src/assets/action-spin/clockoli-16-3.png", "src/assets/action-spin/clockoli-32-3.png",
        "src/assets/action-spin/clockoli-16-4.png", "src/assets/action-spin/clockoli-32-4.png",
        "src/assets/action-spin/clockoli-16-5.png", "src/assets/action-spin/clockoli-32-5.png",
        "src/assets/action-spin/clockoli-16-6.png", "src/assets/action-spin/clockoli-32-6.png",
        "src/assets/action-spin/clockoli-16-7.png", "src/assets/action-spin/clockoli-32-7.png"
      ]
    }
  ],
  "minimum_chrome_version": "102",
  "icons": {
    "16": "src/assets/clockoli-16.png",
    "32": "src/assets/clockoli-32.png",
    "48": "src/assets/clockoli-48.png",
    "128": "src/assets/clockoli-128.png"
  }
}
