{
  "manifest_version": 3,
  "name": "Clockoli",
  "version": "0.1.19",
  "description": "Track time on any task URL and store records in a private GitHub repository.",
  "permissions": [
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/login/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clockoli",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "src/assets/clockoli-16.png",
      "32": "src/assets/clockoli-32.png",
      "48": "src/assets/clockoli-48.png",
      "128": "src/assets/clockoli-128.png"
    }
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "src/domain/recovery-actions.js",
        "src/content/github.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "102",
  "icons": {
    "16": "src/assets/clockoli-16.png",
    "32": "src/assets/clockoli-32.png",
    "48": "src/assets/clockoli-48.png",
    "128": "src/assets/clockoli-128.png"
  }
}
