{
  "manifest_version": 3,
  "name": "Clockoli",
  "version": "0.3.0",
  "description": "Track time on any task URL and store records in private GitHub repositories you control.",
  "permissions": ["alarms", "activeTab", "favicon", "scripting"],
  "host_permissions": ["https://api.github.com/*", "https://github.com/login/*", "https://api.frankfurter.dev/*"],
  "optional_host_permissions": ["https://app.clockify.me/*"],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"},
  "background": {"service_worker": "src/background/service-worker.js", "type": "module"},
  "action": {"default_title": "Clockoli", "default_icon": {"16": "src/assets/clockoli-16.png", "32": "src/assets/clockoli-32.png", "48": "src/assets/clockoli-48.png", "128": "src/assets/clockoli-128.png"}},
  "options_page": "src/options/options.html",
  "content_scripts": [
    {"matches": ["https://github.com/*"], "js": ["src/domain/recovery-actions.js", "src/ui/tracking-card.js", "src/ui/weekly-summary.js", "src/ui/instant-tooltips.js", "src/content/task-timeline-component.js", "src/content/github.js"], "run_at": "document_idle"},
    {"matches": ["https://app.clockify.me/reports/detailed*"], "js": ["src/ui/instant-tooltips.js", "src/addons/clockify/detailed-report-button.js"], "run_at": "document_start"},
    {"matches": ["https://app.clockify.me/reports/detailed*"], "js": ["src/addons/clockify/detailed-report-capture.js"], "run_at": "document_start", "world": "MAIN"}
  ],
  "web_accessible_resources": [{"matches": ["<all_urls>"], "resources": ["_favicon/*", "src/assets/clockoli-16.png", "src/assets/clockoli-32.png", "src/assets/clockoli-with-text.svg", "src/assets/action-spin/clockoli-16-0.png", "src/assets/action-spin/clockoli-32-0.png", "src/assets/action-spin/clockoli-16-1.png", "src/assets/action-spin/clockoli-32-1.png", "src/assets/action-spin/clockoli-16-2.png", "src/assets/action-spin/clockoli-32-2.png", "src/assets/action-spin/clockoli-16-3.png", "src/assets/action-spin/clockoli-32-3.png", "src/assets/action-spin/clockoli-16-4.png", "src/assets/action-spin/clockoli-32-4.png", "src/assets/action-spin/clockoli-16-5.png", "src/assets/action-spin/clockoli-32-5.png", "src/assets/action-spin/clockoli-16-6.png", "src/assets/action-spin/clockoli-32-6.png", "src/assets/action-spin/clockoli-16-7.png", "src/assets/action-spin/clockoli-32-7.png"]}, {"matches": ["https://github.com/*"], "resources": ["src/ui/add-time.js", "src/ui/add-time.css", "src/ui/local-time.js", "src/domain/values.js"]}, {"matches": ["https://app.clockify.me/*"], "resources": ["src/assets/clockoli-32.png"]}],
  "minimum_chrome_version": "102",
  "icons": {"16": "src/assets/clockoli-16.png", "32": "src/assets/clockoli-32.png", "48": "src/assets/clockoli-48.png", "128": "src/assets/clockoli-128.png"}
}
